{
  "name": "review-bridge",
  "version": "1.0.0",
  "description": "MCP server bridging AI coding tools for code review",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "review-bridge": "dist/cli.cjs"
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs && esbuild src/cli.ts --bundle --platform=node --format=cjs --outfile=dist/cli.cjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "handlebars": "^4.7.8",
    "openai": "^4.80.0",
    "simple-git": "^3.27.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
